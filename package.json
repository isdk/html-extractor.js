{
  "name": "@isdk/html-extractor",
  "description": "Extract readable markdown text or structured content from HTML.",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/html-extractor.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/isdk/html-extractor.js.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build-fast": "tsup",
    "build": "pnpm run build-fast --dts-resolve --dts && pnpm run doc:md",
    "clean": "rm -fr web docs dist",
    "doc": "typedoc --plugin none --out web",
    "doc:md": "typedoc --plugin typedoc-plugin-markdown --out docs",
    "style": "pnpm run format -c && pnpm run lint",
    "style:fix": "pnpm run format:fix && npm run lint:fix",
    "format": "prettier \"**/*.{ts,tsx,js,jsx,css,scss,sass,less,md}\"",
    "format:fix": "pnpm run format --write",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "release": "pnpm run clean && pnpm run build && git add -f docs && git ci -m 'docs: update API docs' && npx commit-and-tag-version -s",
    "release.alpha": "pnpm run release -- --prerelease alpha"
  },
  "dependencies": {
    "@isdk/util": "^0.3.11",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "hast-util-from-dom": "^5.0.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "hast-util-to-dom": "^4.0.1",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-mdast": "^10.1.2",
    "jsdom": "^30.0.1",
    "lodash-es": "^4.18.1",
    "rehype": "^13.0.2",
    "rehype-format": "^5.0.1",
    "rehype-ignore": "^2.0.3",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "rehype-video": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.1.0",
    "util-ex": "^2.7.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "~8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "prettier": "^3.9.6",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~5.7.3",
    "vfile": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-fetch-mock": "^0.4.5"
  },
  "files": [
    "docs",
    "dist"
  ],
  "keywords": [
    "html",
    "extract",
    "extractor",
    "markdown",
    "structure",
    "data",
    "text",
    "readability"
  ],
  "maintainers": [
    "Riceball LEE <snowyu.lee@gmail.com>"
  ],
  "engines": {
    "node": ">=20.11.1"
  },
  "types": "./dist/index.d.ts"
}
